<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CoreHtmlToImage" Version="1.0.6" />
      <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
      <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
      <PackageReference Include="LiteDB" Version="5.0.21" />
      <PackageReference Include="MailKit" Version="4.18.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
      <PackageReference Include="NPOI.HWPF" Version="2.3.0" />
      <PackageReference Include="PdfiumViewer" Version="2.13.0" />
      <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" />
      <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
      <PackageReference Include="PdfPig" Version="0.1.16" />
      <PackageReference Include="Polly" Version="8.8.0" />
      <PackageReference Include="SharpZipLib" Version="1.4.2" />
      <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
      <PackageReference Include="SkiaSharp" Version="3.119.4" />
      <PackageReference Include="Spire.Doc" Version="13.5.11" />
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
      <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
      <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
      <PackageReference Include="WeaviateNET" Version="1.23.9.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SearchEngineAgentsConfiguration\SearchEngineAgentsConfiguration.csproj" />
    </ItemGroup>

    <Target Name="CopyConfigurationFiles" AfterTargets="Build">
        <ItemGroup>
            <ConfigFiles Include="$(MSBuildProjectDirectory)\..\SearchEngineAgentsConfiguration\appsettings*.json" />
        </ItemGroup>
        <Copy SourceFiles="@(ConfigFiles)" DestinationFolder="$(OutputPath)" OverwriteReadOnlyFiles="true" />
    </Target>

    <Target Name="CopyConfigurationFilesPublish" AfterTargets="Publish">
        <ItemGroup>
            <ConfigFilesPublish Include="$(MSBuildProjectDirectory)\..\SearchEngineAgentsConfiguration\appsettings*.json" />
        </ItemGroup>
        <Copy SourceFiles="@(ConfigFilesPublish)" DestinationFolder="$(PublishDir)" OverwriteReadOnlyFiles="true" />
    </Target>
</Project>
