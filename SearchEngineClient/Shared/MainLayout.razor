@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="main-layout">
    <SearchBar InitialQuery="@QueryFromUri" />
    <div class="content">
        @Body
    </div>
</div>

@code {
    private string? QueryFromUri =>
        System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query).Get("q");
}