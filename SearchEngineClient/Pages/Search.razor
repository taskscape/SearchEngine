@page "/search"
@using System.Text.RegularExpressions
@using System.Linq
@using System.Web
@using SearchEngineClient.Shared

@using SearchEngineClient.Models
@layout MainLayout
@implements IDisposable
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@inject IConfiguration Configuration

<h1 class="logo searchlogo">
    <span>S</span><span>e</span><span>a</span><span>r</span><span>c</span><span>h</span><span>E</span><span>n</span><span>g</span><span>i</span><span>n</span><span>e</span>
</h1>

<div class="hits">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error" role="alert" aria-live="assertive">
            <span class="error-icon" aria-hidden="true">⚠️</span>
            <span class="error-text">@_error</span>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(_query))
    {
        <p>Please enter a query.</p>
    }
    else if (_isLoading)
    {
        <div class="spinner" role="status" aria-label="Loading"></div>
    }
    else
    {

        @if (_hits.Count == 0)
        {
            <p>No results for <strong>@_query</strong>.</p>
        }
        else
        {
            <div class="results-header" role="status" aria-live="polite">
                <span class="results-count">@_hits.Count</span>
                <span class="results-label">result@(_hits.Count == 1 ? "" : "s") for</span>
                <strong class="results-query">“<mark>@_query</mark>”</strong>

            </div>
            var i = 0;
            @foreach (var hit in _hits)
{
    var ext = GetExt(hit?.Title);
    var delayMs = 40 + (i * 45); i++;

    <div class="hit-card hit-enter"
         style="--enter-delay:@($"{delayMs}ms")"
         @onclick="() => DownloadHitAsync(hit)"
         tabindex="0"
         role="button"
         aria-label="Open @hit?.Title">
        @if (string.IsNullOrWhiteSpace(hit.PreviewIcon))
        {
            <div class="no-icon" aria-hidden="true"><strong>No&nbsp;Icon</strong></div>
        }
        else
        {
            <img src="@GetDataUri(hit.PreviewIcon)" alt="" class="icon" />
        }

        <div class="hit-body">
            <h3 class="hit-title">@((MarkupString)Highlight(hit.Title))</h3>

            @if (!string.IsNullOrWhiteSpace(hit.Content))
            {
                <p class="snippet">@((MarkupString)Highlight(hit.Content ?? string.Empty))</p>
            }

            <div class="meta">
                @if (hit.Timestamp is not null)
                {
                    <time>@hit.Timestamp.Value.ToLocalTime().ToString("g")</time>
                }
                <span class="badge" data-ext="@ext" aria-label="File type">@ext</span>
            </div>
        </div>
    </div>
}

            <div class="pager" hidden="@(_currentPage == 1 && !_hasMore)">
                <button @onclick="PrevPage" disabled="@(_currentPage == 1)" aria-label="Previous page">&#8701;</button>
                <span aria-live="polite">Page @_currentPage</span>
                <button @onclick="NextPage" disabled="@(!_hasMore)" aria-label="Next page">&#8702;</button>
            </div>
        }
    }
</div>

@code {
    private string DownloadApiBase => Configuration["ServerAddress"] + "/download/";

    private string? _query;
    private readonly List<SearchHit> _hits = new();
    private const int PageSize = 10;

    private bool _isLoading;
    private string? _error;

    private int _currentPage = 1;
    private bool _hasMore;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await SyncWithUriAsync(firstLoad: true);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => await SyncWithUriAsync();

    private async Task SyncWithUriAsync(bool firstLoad = false)
    {
        string? q = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query).Get("q");
        if (q != _query || firstLoad)
        {
            _query = q;
            _currentPage = 1;
            await PerformSearchAsync();
            StateHasChanged();
        }
    }

    private async Task PerformSearchAsync()
    {
        _hits.Clear();
        _error = null;
        _hasMore = false;
        if (string.IsNullOrWhiteSpace(_query)) return;

        _isLoading = true;
        try
        {
            string endpoint = $"search/{Uri.EscapeDataString(_query)}?hitsPerPage={PageSize}&page={_currentPage - 1}";
            using HttpResponseMessage response = await Http.GetAsync(endpoint, HttpCompletionOption.ResponseHeadersRead);

            if (!response.IsSuccessStatusCode)
            {
                _error = $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}.";
                return;
            }

            if (!(response.Content.Headers.ContentType?.MediaType?.Contains("json") ?? false))
            {
                _error = "Unexpected response format (not JSON).";
                return;
            }

            SearchResponse? resp = await response.Content.ReadFromJsonAsync<SearchResponse>();
            if (resp?.Results is not null)
            {
                _hits.AddRange(resp.Results.OrderByDescending(h => h.Score));
                _hasMore = _hits.Count == PageSize;
            }
        }
        catch (HttpRequestException ex)
        {
            _error = $"Request error: {ex.Message}";
        }
        catch (System.Text.Json.JsonException)
        {
            _error = "Server returned invalid JSON.";
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetDataUri(string base64) =>
        string.IsNullOrWhiteSpace(base64) ? string.Empty : $"data:image/png;base64,{base64}";

    private async Task DownloadHitAsync(SearchHit hit)
    {
        if (hit is null) return;

        string? physicalPath = hit.Source switch
        {
            SearchSource.Email => hit.DownloadPath,
            SearchSource.File  => hit.Title,
            _ => null
        };

        if (string.IsNullOrWhiteSpace(physicalPath))
        {
            _error = hit.Source == SearchSource.Email
                ? "This email doesn’t have a downloadable path yet. Try reindexing or check server logs."
                : "This result doesn’t have a valid download path.";
            StateHasChanged();
            return;
        }
        
        string url  = $"{DownloadApiBase}{Uri.EscapeDataString(physicalPath)}";
        string name = System.IO.Path.GetFileName(physicalPath);

        try
        {
            await JS.InvokeVoidAsync("fetchAndSave", url, name);
        }
        catch (JSException ex)
        {
            _error = $"Download failed: {ex.Message}";
            StateHasChanged();
        }
    }


    private MarkupString Highlight(string? text)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(_query))
            return (MarkupString)(text ?? string.Empty);

        string[] words = _query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0) return (MarkupString)text!;

        string pattern = string.Join("|", words.Select(Regex.Escape));
        string highlighted = Regex.Replace(text!, pattern, m => $"<mark>{m.Value}</mark>", RegexOptions.IgnoreCase);
        return (MarkupString)highlighted;
    }

    private async Task NextPage()
    {
        if (_hasMore)
        {
            _currentPage++;
            await PerformSearchAsync();
            await ScrollTopAsync();
        }
    }
    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await PerformSearchAsync();
            await ScrollTopAsync();
        }
    }

    private static string GetExt(string? pathOrName)
    {
        if (string.IsNullOrWhiteSpace(pathOrName)) return "FILE";
        try
        {
            var ext = System.IO.Path.GetExtension(pathOrName)?.TrimStart('.').ToUpperInvariant();
            return string.IsNullOrEmpty(ext) ? "FILE" : ext;
        }
        catch { return "FILE"; }
    }

    private async Task ScrollTopAsync() => await JS.InvokeVoidAsync("window.scrollTo", 0, 0);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
